<UserControl x:Class="Percue.View.ChannelSettings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:local="clr-namespace:Percue.View"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="600">
    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="4">
            <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
            <TextBlock Text=" — " VerticalAlignment="Center" Margin="6 0"/>
            <TextBlock Text="{Binding Audio.Length}" VerticalAlignment="Center" Foreground="Gray" />
        </StackPanel>

        <!-- Left: settings (scrollable) -->
        <ScrollViewer Grid.Row="1" Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Orientation="Vertical" Margin="4" MinWidth="320">
                <GroupBox Header="Key Behaviour" Margin="0 0 0 8">
                    <StackPanel Margin="8" VerticalAlignment="Top">
                        <CheckBox IsChecked="{Binding DoPause}" Content="Pause" Margin="0 4" />
                        <CheckBox IsChecked="{Binding DoStopOthers}" Content="Stop others" Margin="0 4" />
                        <local:HotkeyEditorControl Margin="0 8 0 0" Background="White" Hotkey="{Binding ChannelHotKey}" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Playback" Margin="0 0 0 8">
                    <StackPanel Margin="8">
                        <StackPanel Orientation="Horizontal" Margin="0 4">
                            <CheckBox IsChecked="{Binding IsMuted}" Content="Mute" />
                            <CheckBox IsChecked="{Binding IsLooping}" Content="Loop" Margin="12 0" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0 8" VerticalAlignment="Center">
                            <TextBlock Text="Pan" VerticalAlignment="Center" Width="40" />
                            <Slider Orientation="Horizontal" MinWidth="100" Minimum="-1" Maximum="1" TickFrequency="0.1" Value="{Binding Pan, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                            <TextBlock Text="{Binding Pan}" Margin="8 0 0 0" Width="40" VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0 8" VerticalAlignment="Center">
                            <TextBlock Text="Fade-in (s)" VerticalAlignment="Center" Width="80" />
                            <Slider Orientation="Horizontal" MinWidth="100" Minimum="0" Maximum="10" TickFrequency="0.5" Value="{Binding FadeInSeconds, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                            <TextBox Text="{Binding FadeInSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="8 0 0 0" Width="40" VerticalContentAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0 8" VerticalAlignment="Center">
                            <TextBlock Text="Start offset (s)" VerticalAlignment="Center" Width="80" />
                            <Slider  Orientation="Horizontal" MinWidth="100" Minimum="0" Maximum="60" TickFrequency="0.5" Value="{Binding StartOffsetSeconds, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                            <TextBox Text="{Binding StartOffsetSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:F2}'}" Margin="8 0 0 0" Width="60" VerticalAlignment="Center" HorizontalContentAlignment="Right" />
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>

        <!-- Right: waveform + volume -->
        <Grid Grid.Row="1" Grid.Column="1" Margin="8 0 0 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Vertical volume slider -->
            <Slider Grid.Column="0" Margin="0 0 8 0" Minimum="0" Maximum="1" TickFrequency="0.05" Value="{Binding ChannelVolume, Mode=TwoWay}" TickPlacement="Both" Orientation="Vertical" VerticalAlignment="Stretch" Height="Auto"/>

            <!-- Waveform image stretches to available space -->
            <Border Grid.Column="1" BorderBrush="LightGray" BorderThickness="1" CornerRadius="4">
                <Image Source="{Binding WaveImg}" Stretch="Uniform" />
            </Border>
        </Grid>

        <!-- Footer: playback and actions -->
        <DockPanel Grid.Row="2" Grid.ColumnSpan="2" LastChildFill="False" Margin="4 12 4 4">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                <ToggleButton IsChecked="{Binding IsPlaying, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinWidth="80" Height="36">
                        <iconPacks:PackIconMaterial Kind="Play" Width="18" Height="18" />
                    </ToggleButton>    

                <!-- korrigiert: Play statt PlayArrow -->
            </StackPanel>

            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="Delete" Click="Button_Click" Background="IndianRed" Foreground="White" MinWidth="80" Margin="0 0 8 0" />
                <Button Content="OK" Click="Button_Click_1" MinWidth="80" />
            </StackPanel>
        </DockPanel>

    </Grid>
</UserControl>
